{
  "profile_id": "dds.apple-dark-16x9",
  "profile_version": "1.1.0",
  "canonical_template": "templates/dds_report_apple_16x9.html",
  "canonical_demo_builder": "demos/dds-template-lab/build_template_lab.py",
  "framework_version": "dds.report-framework/sc-ad-va-cs/1.0",
  "viewport_policy": {
    "desktop_only": true,
    "aspect_ratio": "16:9",
    "acceptance_viewports": [
      "1280x720",
      "1440x900",
      "1920x1080"
    ]
  },
  "page_header": {
    "left": "display_code + single-line display_title",
    "display_title_max_chars": 18,
    "right": "decision_question",
    "hide_repeated_group_labels_in_compact_view": true
  },
  "page_body": {
    "one_primary_judgment": true,
    "one_primary_visual": true,
    "internal_card_scroll": false,
    "chart_support_layout": "8-column primary visual + 4-column support"
  },
  "page_conclusion": {
    "position": "full-width bottom",
    "material": "neutral dark plate",
    "glow": "outer cool-white to ice-blue edge only",
    "inner_glow": false
  },
  "visual_languages": [
    "decision_narrative",
    "evidence_audit",
    "spatial_diagram"
  ],
  "chart_palette": {
    "observed_market_gis": "#64d2ff",
    "opportunity_recommendation": "#30d158",
    "cycle_warning": "#ff9f0a",
    "comparison_secondary": "#bf5af2",
    "risk_blocked": "#d98268"
  },
  "spatial_diagram": {
    "neutral_background": true,
    "green_grid_forbidden": true,
    "true_north_or_gap_required": true,
    "scale_or_not_to_scale_required": true,
    "schematic_must_not_impersonate_cad_or_approval": true
  },
  "navigation": {
    "default_mode": "reading",
    "single_level_top_control": true,
    "left_catalog": true,
    "right_source_index": true,
    "presentation_autoplay": false
  },
  "runtime": {
    "max_mounted_pages": 7,
    "max_live_dom": 1500,
    "max_interactive_charts": 3,
    "max_decoded_images": 12,
    "offline_runtime": true,
    "readable_failure_fallback": true
  }
}
