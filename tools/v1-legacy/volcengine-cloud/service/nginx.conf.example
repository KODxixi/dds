# DDS 独立站点反向代理示例配置
# 部署在云主机 Nginx 上，将外部请求转发到容器内 Flask（127.0.0.1:8080）
#
# 使用方式：
#   1. 复制到 /etc/nginx/conf.d/dds.conf
#   2. 修改 server_name 为你的域名
#   3. 配置 SSL 证书路径（取消注释 ssl_certificate 行）
#   4. nginx -t && nginx -s reload
#
# GarchOS 子页面接入：所有 HMAC 请求头必须原样透传至 Flask。

upstream dds_app_upstream {
    server 127.0.0.1:8080;
    keepalive 32;
}

# 限流：每 IP 每秒 6 个请求，突发 18 个
limit_req_zone $binary_remote_addr zone=dds_api:10m rate=6r/s;

# GarchOS HMAC 请求头映射（透传至 Flask）
map $http_x_dds_key_id $dds_key_id { default $http_x_dds_key_id; }
map $http_x_dds_request_id $dds_request_id { default $http_x_dds_request_id; }
map $http_x_dds_content_sha256 $dds_content_sha256 { default $http_x_dds_content_sha256; }
map $http_x_dds_signature $dds_signature { default $http_x_dds_signature; }
map $http_x_garchos_user_id $garchos_user_id { default $http_x_garchos_user_id; }
map $http_x_garchos_user_role $garchos_user_role { default $http_x_garchos_user_role; }

server {
    listen 443 ssl http2;
    server_name dds.example.com;

    # SSL 证书（生产环境必须配置）
    # ssl_certificate /etc/letsencrypt/live/dds.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/dds.example.com/privkey.pem;

    # DDS API 请求体较大（报告生成含完整 JSON 上下文）
    client_max_body_size 2m;

    # ── 健康检查 ────────────────────────────────────────────────────────────
    location = /api/health {
        proxy_pass http://dds_app_upstream/api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ── API 路由 ─────────────────────────────────────────────────────────────
    # 报告生成耗时较长（ABM 蒙特卡洛 + LLM 调用），超时设为 120 秒
    location /api/ {
        limit_req zone=dds_api burst=18 nodelay;
        proxy_pass http://dds_app_upstream/api/;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # GarchOS HMAC 请求头透传
        proxy_set_header X-DDS-Key-ID $dds_key_id;
        proxy_set_header X-DDS-Request-ID $dds_request_id;
        proxy_set_header X-DDS-Content-SHA256 $dds_content_sha256;
        proxy_set_header X-DDS-Signature $dds_signature;
        proxy_set_header X-GarchOS-User-ID $garchos_user_id;
        proxy_set_header X-GarchOS-User-Role $garchos_user_role;
    }

    # ── GarchOS 子页面代理 ──────────────────────────────────────────────────
    location /dds/ {
        limit_req zone=dds_api burst=18 nodelay;
        proxy_pass http://dds_app_upstream/dds/;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-DDS-Key-ID $dds_key_id;
        proxy_set_header X-DDS-Request-ID $dds_request_id;
        proxy_set_header X-DDS-Content-SHA256 $dds_content_sha256;
        proxy_set_header X-DDS-Signature $dds_signature;
        proxy_set_header X-GarchOS-User-ID $garchos_user_id;
        proxy_set_header X-GarchOS-User-Role $garchos_user_role;
    }

    # ── Decision Field 项目路由 ──────────────────────────────────────────────
    location /projects/ {
        limit_req zone=dds_api burst=18 nodelay;
        proxy_pass http://dds_app_upstream/projects/;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-DDS-Key-ID $dds_key_id;
        proxy_set_header X-DDS-Request-ID $dds_request_id;
        proxy_set_header X-DDS-Content-SHA256 $dds_content_sha256;
        proxy_set_header X-DDS-Signature $dds_signature;
        proxy_set_header X-GarchOS-User-ID $garchos_user_id;
        proxy_set_header X-GarchOS-User-Role $garchos_user_role;
    }

    # ── 报告文件下载 ─────────────────────────────────────────────────────────
    location /reports/ {
        proxy_pass http://dds_app_upstream/reports/;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-DDS-Key-ID $dds_key_id;
        proxy_set_header X-DDS-Request-ID $dds_request_id;
        proxy_set_header X-DDS-Content-SHA256 $dds_content_sha256;
        proxy_set_header X-DDS-Signature $dds_signature;
        proxy_set_header X-GarchOS-User-ID $garchos_user_id;
        proxy_set_header X-GarchOS-User-Role $garchos_user_role;
    }

    # ── 前端 Web 界面 ─────────────────────────────────────────────────────────
    # DDS 是单文件 SPA（index.html），由 Flask 直接返回
    location / {
        proxy_pass http://dds_app_upstream/;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-DDS-Key-ID $dds_key_id;
        proxy_set_header X-DDS-Request-ID $dds_request_id;
        proxy_set_header X-DDS-Content-SHA256 $dds_content_sha256;
        proxy_set_header X-DDS-Signature $dds_signature;
        proxy_set_header X-GarchOS-User-ID $garchos_user_id;
        proxy_set_header X-GarchOS-User-Role $garchos_user_role;
    }
}

# HTTP → HTTPS 重定向
server {
    listen 80;
    server_name dds.example.com;
    return 301 https://$host$request_uri;
}
