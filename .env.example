AMAP_KEY=your_amap_web_api_key
AMAP_JS_KEY=your_amap_js_api_key
AMAP_SECURITY_CODE=your_amap_js_security_code
ANTHROPIC_AUTH_TOKEN=your_deepseek_api_key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-chat
# APIYI 兜底后端（主后端失败/超时自动降级）。base_url 不加 /v1
APIYI_KEY=your_apiyi_api_key
APIYI_BASE_URL=https://api.apiyi.com
APIYI_MODEL=claude-haiku-4-5-20251001

# [T7] 政府数据源（L1 信任层）— 从配置读 URL，未设置时脚本优雅降级
# 杭州备案价抓取
HZ_PRICE_URL=https://your-hangzhou-price-api.gov.cn
# 三亚备案价抓取
SANYA_PRICE_URL=https://your-sanya-price-api.gov.cn
# 杭州成交数据抓取
HZ_DEALS_URL=https://your-hangzhou-deals-api.gov.cn
# 三亚成交数据抓取
SANYA_DEALS_URL=https://your-sanya-deals-api.gov.cn
